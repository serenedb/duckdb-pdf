# name: test/sql/read_pdf_tables.test
# group: [sql]

require pdf

query IIITT
SELECT page, table_index, row_index, cells[1], cells[2]
FROM read_pdf_tables('../duckdb_pdf/test/data/varusik.pdf') ORDER BY page, table_index, row_index;
----
1	1	1	varusik	banochka
1	1	2	sopley	42

query ITT
SELECT row_index, cells[1], cells[2]
FROM read_pdf_tables('../duckdb_pdf/test/data/varusik_encrypted.pdf', password := 'varusik', first_page := 1, last_page := 1)
ORDER BY row_index;
----
1	varusik	banochka
2	sopley	42

query I
SELECT count(*) FROM read_pdf_tables('../duckdb_pdf/test/data/varusik.pdf', first_page := 2);
----
0

query II
SELECT count(DISTINCT filename), count(*)
FROM read_pdf_tables('../duckdb_pdf/test/data/varusik*.pdf', password := 'varusik');
----
2	4

statement error
SELECT * FROM read_pdf_tables('../duckdb_pdf/test/data/varusik_encrypted.pdf', password := 'wrong');
----
PDF is encrypted

statement error
SELECT * FROM read_pdf_tables('../duckdb_pdf/test/data/blank.pdf');
----
no extractable text

statement error
SELECT * FROM read_pdf_tables('../duckdb_pdf/test/data/varusik.pdf', first_page := 2, last_page := 1);
----
first_page must not exceed last_page

statement error
SELECT * FROM read_pdf_tables('../duckdb_pdf/test/data/varusik.pdf', first_page := NULL);
----
options must not be NULL

statement error
SELECT * FROM read_pdf_tables('../duckdb_pdf/test/data/invalid.pdf');
----
could not extract PDF text
