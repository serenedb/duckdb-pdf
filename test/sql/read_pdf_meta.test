# name: test/sql/read_pdf_meta.test
# group: [sql]

require pdf

query TTTTTTITI
SELECT title, author, subject, keywords, creator, producer, pages, pdf_version, encrypted
FROM read_pdf_meta('../duckdb_pdf/test/data/inspect_varusik.pdf');
----
varusik report	varusik	banochka	sopley	varusik generator	SereneDB	2	1.4	false

query TII
SELECT title, pages, encrypted FROM read_pdf_meta('../duckdb_pdf/test/data/varusik_encrypted.pdf', password := 'varusik');
----
(empty)	2	true

query II
SELECT count(*), sum(pages) FROM read_pdf_meta('../duckdb_pdf/test/data/varusik*.pdf', password := 'varusik');
----
2	4

query I
SELECT count(*) FROM read_pdf_meta('../duckdb_pdf/test/data/varusik*.pdf', ignore_errors := true);
----
1

query I
SELECT count(*) FROM read_pdf_meta('../duckdb_pdf/test/data/blank.pdf');
----
1

query I
SELECT count(*) FROM read_pdf_meta('../duckdb_pdf/test/data/invalid.pdf', ignore_errors := true);
----
0

statement error
SELECT * FROM read_pdf_meta('../duckdb_pdf/test/data/invalid.pdf');
----
could not inspect PDF

statement error
SELECT * FROM read_pdf_meta('../duckdb_pdf/test/data/varusik_encrypted.pdf');
----
PDF is encrypted

statement error
SELECT * FROM read_pdf_meta('../duckdb_pdf/test/data/varusik.pdf', ignore_errors := NULL);
----
options must not be NULL
